APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# P7-002 production target (D7-01 self-hosted PostgreSQL): set
# DB_CONNECTION=pgsql with DB_HOST/DB_PORT=5432/DB_DATABASE/DB_USERNAME
# and a provisioned DB_PASSWORD plus DB_SSLMODE at cutover. Pre-cutover
# sqlite stays legal; the pgsql variables are advisory until then
# (flip owned by P7-002, enforced by DatastorePosture).
# DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Optional absolute path to ffprobe; defaults to the ffprobe executable on PATH.
RTFTT_FFPROBE_PATH=ffprobe
QUEUE_CONNECTION=database

# Phase 5 translation queue (see worker/TRANSLATION-OPERATIONS.md).
# Leave the connection empty to use QUEUE_CONNECTION; the effective connection
# must have retry_after >= translation.retry_after_seconds (420s by default),
# otherwise application boot fails fast (TranslationQueueConfig).
RTFTT_TRANSLATION_QUEUE_CONNECTION=
DB_QUEUE_RETRY_AFTER=420
REDIS_QUEUE_RETRY_AFTER=420

# P7-003 production queue posture (D7-02: Redis + OS supervision, no
# Horizon). Dev/test keep the `database` default above; production sets:
#   QUEUE_CONNECTION=redis
#   RTFTT_TRANSCRIPTION_QUEUE_CONNECTION=redis
#   RTFTT_TRANSLATION_QUEUE_CONNECTION=redis
#   REDIS_PASSWORD=<secret> (required whenever Redis leaves loopback or is
#     shared; see TD-004 and docs/QUEUE-WORKER-SUPERVISION.md)
# Transcription queue mirrors the translation convention: leave the
# connection empty to use QUEUE_CONNECTION; the effective connection must
# have retry_after >= transcription.retry_after_seconds (420s by default),
# otherwise application boot fails fast (TranscriptionQueueConfig).
# The `sync`/`null` drivers are prohibited for both queues outside tests.
RTFTT_TRANSCRIPTION_QUEUE_CONNECTION=
RTFTT_TRANSCRIPTION_JOB_TIMEOUT_SECONDS=330
RTFTT_TRANSCRIPTION_RETRY_AFTER_SECONDS=420

# P7-008 production hardening block (deployment-owned; queue keys owned by
# P7-003 above — this block only references them, never redefines them).
# Production requires: APP_ENV=production, APP_DEBUG=false,
# QUEUE_CONNECTION=redis, a generated APP_KEY, production PostgreSQL DSN
# (DB_*, target of P7-002), REDIS_PASSWORD whenever Redis leaves loopback
# or is shared (TD-004), production worker URLs/tokens
# (RTFTT_*_WORKER_URL must not be localhost; tokens provisioned), and
# restricted .env permissions. Missing/unsafe settings fail fast at boot
# (ProductionConfigGuard + queue guards). Full matrix:
# docs/DEPLOYMENT-RUNBOOK.md §2.

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# P7-006 self-hosted ClamAV (D7-04; keys owned by P7-006, shapes in
# ProductionEnvRegistry). Daemon socket preferred; TCP loopback fallback.
# Non-loopback TCP is refused unless CLAMAV_ALLOW_NON_LOOPBACK=true (never
# for third parties — user media must not leave the host). Unavailable
# scanner fails closed (hold|reject). Disabled by default: non-production
# skips with a log line; production treats disabled as unavailable.
CLAMAV_ENABLED=false
# CLAMAV_SOCKET=/var/run/clamav/clamd.sock
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# CLAMAV_ALLOW_NON_LOOPBACK=false
CLAMAV_TIMEOUT_SECONDS=60
CLAMAV_MAX_SIGNATURE_AGE_HOURS=48
CLAMAV_UNAVAILABLE_MODE=reject

# P7-007 backup foundation (keys owned by P7-007, shapes in
# ProductionEnvRegistry). Local target directory + retained daily
# generations. PostgreSQL-native backup activates only after P7-002.
RTFTT_BACKUP_TARGET=
RTFTT_BACKUP_GENERATIONS=7
